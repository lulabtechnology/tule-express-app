<%- include('partials/flash') %>

<section class="hero">
  <div class="container py-5">
    <div class="row align-items-center g-4">
      <div class="col-lg-6">
        <span class="badge text-bg-light border">Preparación que marca la diferencia</span>
        <h1 class="display-6 fw-bold mt-3">Transporte con seguridad, confianza y corazón</h1>
        <p class="lead text-muted mt-3">
          En Tule Express priorizamos normas de tránsito, primeros auxilios, servicio al cliente y cuidado integral.
        </p>
        <div class="d-flex gap-2 mt-4">
