<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<section class="container py-5">
  <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
      <h1 class="h3 fw-bold mb-1">Reservas</h1>
      <div class="text-muted">Estado: <strong><%= status %></strong></div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-outline-dark" href="/admin/reservas?status=PENDING">Pendientes</a>
      <a class="btn btn-outline-dark" href="/admin/reservas?status=ACCEPTED">Aceptadas</a>
      <a class="btn btn-outline-dark" href="/admin/reservas?status=REJECTED">Rechazadas</a>
      <a class="btn btn-outline-dark" href="/admin/reservas?status=CANCELLED">Canceladas</a>
    </div>
  </div>

  <div class="card shadow-sm mt-3">
    <div class="table-responsive">
      <table class="table table-striped mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>Código</th>
            <th>Cliente</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Personas</th>
            <th>Fecha (UTC)</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% (list || []).forEach(function(r){ %>
            <tr>
              <td><%= r.id %></td>
              <td class="fw-semibold"><%= r.code %></td>
              <td><%= r.customer_name %></td>
              <td><%= r.customer_email %></td>
              <td><%= r.customer_phone %></td>
              <td><%= r.people_count %></td>
              <td><%= r.requested_start_utc %></td>
              <td><a class="btn btn-sm btn-outline-dark" href="/admin/reservas/<%= r.id %>">Ver</a></td>
            </tr>
          <% }) %>
          <% if (!list || !list.length) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">Sin registros.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
