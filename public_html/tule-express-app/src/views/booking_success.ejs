<%- include('partials/head', { pageTitle }) %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<section class="container py-5">
  <div class="card p-4 shadow-sm">
    <h1 class="h4 fw-bold mb-2">Solicitud enviada ✅</h1>
    <p class="text-muted mb-4">Tu solicitud quedó en estado <strong>PENDIENTE</strong>. El admin la revisará.</p>

    <div class="row g-3">
      <div class="col-md-6">
        <div class="small text-muted">Código</div>
        <div class="h5 fw-bold"><%= reservation.code %></div>
      </div>
      <div class="col-md-6">
        <div class="small text-muted">Fecha/Hora (Panamá)</div>
        <div class="h5 fw-semibold"><%= startPana %></div>
      </div>
    </div>

    <hr>

    <div class="d-flex flex-column flex-md-row gap-2">
      <a class="btn btn-success btn-lg" target="_blank" rel="noopener" href="<%= waUrl %>">
        Abrir WhatsApp con mensaje
      </a>
      <a class="btn btn-outline-dark btn-lg" href="/reservar">Crear otra solicitud</a>
    </div>

    <div class="mt-3 small text-muted">
      WhatsApp es para coordinar, pero el control lo mantiene el sistema.
    </div>
  </div>
</section>

<%- include('partials/footer') %>
