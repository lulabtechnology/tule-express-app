<%- include('partials/head', { pageTitle }) %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<section class="container py-5">
  <h1 class="h3 fw-bold">Reservar</h1>
  <p class="text-muted">Crea una solicitud. Recibirás un código y luego podrás abrir WhatsApp con el mensaje prellenado.</p>

  <% if (errors && errors.length) { %>
    <div class="alert alert-danger">
      <div class="fw-semibold mb-1">Revisa lo siguiente:</div>
      <ul class="mb-0">
        <% errors.forEach(function(e){ %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <div class="card p-4 shadow-sm">
    <form method="POST" action="/reservar">
      <input type="hidden" name="_csrf" value="<%= _csrf %>">

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Servicio</label>
          <select class="form-select" name="service_id" required>
            <option value="">Selecciona...</option>
            <% (services || []).forEach(function(s){ %>
              <option value="<%= s.id %>" <%= String(form.service_id) === String(s.id) ? "selected" : "" %>>
                <%= s.name %> — <%= s.duration_minutes %> min
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label">Fecha y hora (Panamá)</label>
          <input class="form-control" type="datetime-local" name="datetime_local" value="<%= form.datetime_local || "" %>" required>
        </div>

        <div class="col-md-6">
          <label class="form-label">Nombre del cliente</label>
          <input class="form-control" name="customer_name" value="<%= form.customer_name || "" %>" required>
        </div>

        <div class="col-md-6">
          <label class="form-label">Teléfono</label>
          <input class="form-control" name="customer_phone" value="<%= form.customer_phone || "" %>" required>
        </div>

        <div class="col-md-6">
          <label class="form-label">Email</label>
          <input class="form-control" type="email" name="customer_email" value="<%= form.customer_email || "" %>" required>
        </div>

        <div class="col-md-6">
          <label class="form-label">Cantidad de personas</label>
          <input class="form-control" type="number" min="1" max="99" name="people_count" value="<%= form.people_count || 1 %>" required>
        </div>

        <div class="col-12">
          <label class="form-label">Notas</label>
          <textarea class="form-control" rows="3" name="notes" required><%= form.notes || "" %></textarea>
          <div class="form-text">Ej: niños, puntos de referencia, necesidades especiales, etc.</div>
        </div>

        <div class="col-12 d-flex gap-2">
          <button class="btn btn-primary btn-lg">Crear solicitud</button>
          <a class="btn btn-outline-dark btn-lg" href="/servicios">Ver servicios</a>
        </div>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
